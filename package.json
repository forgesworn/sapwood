{
  "name": "sapwood",
  "version": "0.16.0-alpha.1",
  "description": "Shape your signer -- web management UI for Heartwood ESP32",
  "type": "module",
  "license": "MIT",
  "homepage": "https://sapwood.forgesworn.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgesworn/sapwood.git"
  },
  "keywords": [
    "nostr",
    "esp32",
    "hardware-signer",
    "web-serial",
    "nip-46",
    "heartwood",
    "signing-device",
    "management-ui"
  ],
  "bin": {
    "sapwood": "dist-cli/sapwood.mjs"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "build:cli": "node scripts/build-cli.mjs",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "check:cli": "tsc -p cli/tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "sync:firmware": "node scripts/sync-firmware.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/svelte": "^5.4.2",
    "@tsconfig/svelte": "^5.0.0",
    "@types/node": "^26.4.1",
    "@types/w3c-web-serial": "^1.0.8",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.7.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.10",
    "ws": "^8.21.3"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@noble/ciphers": "^2.4.0",
    "@noble/curves": "^2.4.0",
    "@noble/hashes": "^2.4.0",
    "@paulmillr/qr": "^0.3.0",
    "@scure/bip32": "^2.4.0",
    "@scure/bip39": "^2.4.0",
    "esptool-js": "^0.6.1",
    "nostr-tools": "2.23.9",
    "serialport": "^13.0.0"
  }
}
