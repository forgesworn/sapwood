{
  "name": "sapwood",
  "version": "0.8.9",
  "description": "Shape your signer -- web management UI for Heartwood ESP32",
  "type": "module",
  "license": "MIT",
  "homepage": "https://sapwood.forgesworn.dev/",
  "repository": {
    "type": "git",
    "url": "https://github.com/forgesworn/sapwood.git"
  },
  "keywords": [
    "nostr",
    "esp32",
    "hardware-signer",
    "web-serial",
    "nip-46",
    "heartwood",
    "signing-device",
    "management-ui"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks || true",
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "sync:firmware": "node scripts/sync-firmware.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@testing-library/svelte": "^5.4.1",
    "@tsconfig/svelte": "^5.0.0",
    "@types/w3c-web-serial": "^1.0.8",
    "jsdom": "^29.1.1",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "dependencies": {
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@noble/curves": "^2.2.0",
    "@noble/hashes": "^2.2.0",
    "@paulmillr/qr": "^0.3.0",
    "@scure/bip32": "^2.2.0",
    "@scure/bip39": "^2.2.0",
    "esptool-js": "^0.6.0",
    "nostr-tools": "^2.23.5"
  }
}
