# sapwood.forgesworn.dev — the Flasher + admin SPA, served as static files from
# /opt/sapwood on the shared "routing" box (95.217.39.110).
#
# Install: copy to /etc/caddy/conf.d/ (imported by the main Caddyfile), validate,
# reload. This block is fully self-contained and touches no other tenant.
#
# Auto-TLS: the A record is grey-cloud (DNS-only), so Caddy sees the real client
# and issues a Let's Encrypt cert. HTTPS is required for the flasher's Web Serial.
sapwood.forgesworn.dev {
	root * /opt/sapwood
	encode gzip zstd

	# Cache policy. Vite content-hashes everything under /assets/, so those files
	# are immutable — cache for a year. Everything else (index.html; the firmware
	# binaries and version.json, which live at FIXED paths but change each
	# release) is no-cache: browsers keep a copy but revalidate the ETag before
	# using it, so every deploy shows on the next load. Without an explicit
	# Cache-Control, browsers heuristically cache index.html for hours.
	@assets {
		path /assets/*
		file
	}
	header @assets Cache-Control "public, max-age=31536000, immutable"

	header {
		# Privacy + hardening. The app's own CSP ships in index.html.
		Referrer-Policy no-referrer
		X-Content-Type-Options nosniff
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(self), serial=(self)"
		# Anti-clickjacking: the signer-management controls (regenerate the
		# operator key, revoke clients, factory reset) are software-only, so a
		# framed instance would be clickjackable. A <meta> CSP cannot express
		# frame-ancestors, so it is set here as a real response header.
		X-Frame-Options DENY
		Content-Security-Policy "frame-ancestors 'none'"
		-Server
		# Only where /assets/* has not already claimed the header (? = default).
		?Cache-Control "no-cache"
	}

	# The public site has no bridge API. handle blocks are matched in source
	# order, so /api/* is answered with 404 BEFORE the SPA fallback can serve
	# index.html for it — otherwise the admin's auto-connect probe mistakes that
	# HTML 200 for a bridge and chokes parsing it as JSON.
	handle /api/* {
		respond 404
	}

	# Hashed assets must never fall back to index.html. A stale tab requesting an
	# old hashed JS file should get a clear 404, not HTML with an immutable cache
	# header.
	handle /assets/* {
		file_server
	}

	# Fixed static files also serve as files only. Unknown app routes still fall
	# through to the SPA below.
	handle /firmware/* {
		file_server
	}
	handle /favicon.svg {
		file_server
	}
	handle /manifest.webmanifest {
		file_server
	}
	handle /robots.txt {
		file_server
	}
	handle /llms.txt {
		file_server
	}

	# Static SPA: unknown paths fall back to index.html (routing is hash-based).
	handle {
		try_files {path} /index.html
		file_server
	}
}
